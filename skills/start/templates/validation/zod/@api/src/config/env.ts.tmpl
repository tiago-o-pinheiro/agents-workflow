import { StatusCodes } from 'http-status-codes'
import { z } from 'zod'

import { GlobalError } from '{{imports.apiSrc}}/errors/global-error'

export const Env = z.object({
  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),
  PORT: z.coerce.number().int().min(1).max(65535).default({{api.port}}),
  CORS_ORIGIN: z.string().min(1).default('http://localhost:{{web.port}}'),
})
export type Env = z.infer<typeof Env>

export const parseEnv = (source: Record<string, string | undefined>): Env => {
  const parsed = Env.safeParse(source)
  if (!parsed.success) {
    const problems = parsed.error.issues.map(
      (issue) => `- ${issue.path.join('.')}: ${issue.message}`,
    )
    throw new GlobalError(
      ['Invalid environment variables:', ...problems].join('\n'),
      StatusCodes.INTERNAL_SERVER_ERROR,
    )
  }
  return parsed.data
}

export const env = parseEnv(process.env)
