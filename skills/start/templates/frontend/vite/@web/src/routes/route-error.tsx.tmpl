import { useNavigate } from 'react-router'

import { Button } from '{{imports.ui}}/button'

export const RouteError = () => {
  const navigate = useNavigate()

  return (
    <main className="mx-auto flex min-h-dvh max-w-2xl flex-col items-start justify-center gap-4 p-6">
      <h1 className="text-2xl font-semibold">Something went wrong on our side</h1>
      <p className="text-muted-foreground">Nothing you did caused this. Please try again.</p>
      <Button onClick={() => void navigate(0)}>Try again</Button>
    </main>
  )
}
