{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {},
    "lint": {},
    "lint:fix": { "cache": false },
    "test": {},
    "test:ci": { "outputs": ["coverage/**"] },
    "dev": { "cache": false, "persistent": true }
  }
}
