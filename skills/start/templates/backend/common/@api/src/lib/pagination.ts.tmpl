import { type Models } from '{{imports.models}}'

export type Pagination = {
  take: number
  skip: number
}

export const toPagination = (query: Models.PaginationQuery): Pagination => ({
  take: query.pageSize,
  skip: (query.page - 1) * query.pageSize,
})

export const toPaginationMeta = (
  total: number,
  query: Models.PaginationQuery,
): Models.PaginationMeta => ({
  total,
  page: query.page,
  pageSize: query.pageSize,
})
