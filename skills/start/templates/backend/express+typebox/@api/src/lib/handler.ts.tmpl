import { type RequestHandler, type Response } from 'express'
import { type StaticDecode, type TSchema } from 'typebox'

import { coerce as coerceInput, decode } from '{{imports.apiSrc}}/lib/codec'

type ApiSchema = {
  params?: TSchema
  query?: TSchema
  body?: TSchema
  response?: Record<number, TSchema>
}

type Decoded<Schema extends TSchema | undefined> = Schema extends TSchema
  ? StaticDecode<Schema>
  : undefined

export type HandlerInput<Schema extends ApiSchema> = {
  params: Decoded<Schema['params']>
  query: Decoded<Schema['query']>
  body: Decoded<Schema['body']>
}

export type Handler<Schema extends ApiSchema> = (
  input: HandlerInput<Schema>,
  response: Response,
) => void | Promise<void>

const decodeOptional = (schema: TSchema | undefined, input: unknown, coerce: boolean): unknown => {
  if (!schema) {
    return undefined
  }
  return decode(schema, coerce ? coerceInput(schema, input) : input)
}

const isHandlerInput = <Schema extends ApiSchema>(
  schema: Schema,
  input: Record<'params' | 'query' | 'body', unknown>,
): input is HandlerInput<Schema> =>
  (['params', 'query', 'body'] as const).every(
    (key) => schema[key] === undefined || input[key] !== undefined,
  )

export const handle =
  <Schema extends ApiSchema>(schema: Schema, handler: Handler<Schema>): RequestHandler =>
  async (request, response) => {
    const input = {
      params: decodeOptional(schema.params, request.params, true),
      query: decodeOptional(schema.query, request.query, true),
      body: decodeOptional(schema.body, request.body, false),
    }
    if (!isHandlerInput(schema, input)) {
      throw new TypeError('Handler input does not match its api-schema')
    }
    await handler(input, response)
  }
