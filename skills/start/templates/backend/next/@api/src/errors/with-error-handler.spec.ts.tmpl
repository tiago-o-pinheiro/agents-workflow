import { StatusCodes } from 'http-status-codes'
import { describe, expect, it } from 'vitest'

import { ConflictError } from '{{imports.apiSrc}}/errors/http-errors'

import { withErrorHandler } from './with-error-handler'

const request = new Request('http://test/api/things')

describe('withErrorHandler', () => {
  it('Given a handler that succeeds, should return its response untouched', async () => {
    const handler = withErrorHandler(() => Response.json({ id: '::id::' }))

    const response = await handler(request)

    expect(response.status).toBe(StatusCodes.OK)
    expect(await response.json()).toEqual({ id: '::id::' })
  })

  it('Given a global error, should respond with its status and details', async () => {
    const handler = withErrorHandler(() => {
      throw new ConflictError('::message::', { field: '::field::' })
    })

    const response = await handler(request)

    expect(response.status).toBe(StatusCodes.CONFLICT)
    expect(await response.json()).toEqual({
      statusCode: StatusCodes.CONFLICT,
      error: 'Conflict',
      message: '::message::',
      details: { field: '::field::' },
    })
  })

  it('Given an unknown error, should respond 500 without leaking internals', async () => {
    const handler = withErrorHandler(() => {
      throw new Error('::secret::')
    })

    const response = await handler(request)

    expect(response.status).toBe(StatusCodes.INTERNAL_SERVER_ERROR)
    expect(await response.text()).not.toContain('::secret::')
  })
})
