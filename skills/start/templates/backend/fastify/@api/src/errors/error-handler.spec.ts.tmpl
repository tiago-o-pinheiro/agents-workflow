import { fastify } from 'fastify'
import { StatusCodes } from 'http-status-codes'
import { afterEach, beforeEach, describe, expect, it } from 'vitest'

import { Models } from '{{imports.models}}'

import { applyTypeProvider, type TypedApp } from '@/lib/type-provider'

import { errorHandler } from './error-handler'
import { ConflictError } from './http-errors'

describe('errorHandler', () => {
  let app: TypedApp

  beforeEach(async () => {
    app = applyTypeProvider(fastify())
    app.setErrorHandler(errorHandler)
    app.get('/conflict', () => {
      throw new ConflictError('::message::', { field: '::field::' })
    })
    app.get('/boom', () => {
      throw new Error('::secret::')
    })
    app.get('/page', { schema: { querystring: Models.PaginationQuery } }, (request) => request.query)
    await app.ready()
  })

  afterEach(async () => {
    await app.close()
  })

  it('Given a global error, should respond with its status and details', async () => {
    const response = await app.inject({ method: 'GET', url: '/conflict' })

    expect(response.statusCode).toBe(StatusCodes.CONFLICT)
    expect(response.json()).toEqual({
      statusCode: StatusCodes.CONFLICT,
      error: 'Conflict',
      message: '::message::',
      details: { field: '::field::' },
    })
  })

  it('Given an unknown error, should respond 500 without leaking internals', async () => {
    const response = await app.inject({ method: 'GET', url: '/boom' })

    expect(response.statusCode).toBe(StatusCodes.INTERNAL_SERVER_ERROR)
    expect(response.body).not.toContain('::secret::')
  })

  it('Given a query that fails the schema, should respond unprocessable', async () => {
    const response = await app.inject({ method: 'GET', url: '/page?pageSize=1000' })

    expect(response.statusCode).toBe(StatusCodes.UNPROCESSABLE_ENTITY)
  })

  it('Given an empty query, should apply the schema defaults', async () => {
    const response = await app.inject({ method: 'GET', url: '/page' })

    expect(response.json()).toEqual({ page: 1, pageSize: 20 })
  })
})
